# ── Case research artifacts (not for publish) ──
cases/**/*.py
cases/**/*.csv
cases/**/*.ipynb
cases/**/*_raw.json
cases/**/pyproject.toml
cases/**/requirements.txt

# ── Exceptions: story_v* dirs are publish assets (keep everything) ──
!cases/**/story_v*/
!cases/**/story_v*/**

# ── Exceptions: llm-ab-case publish code and figures ──
!cases/llm-ab-case/generate_data.py
!cases/llm-ab-case/analyze.py
!cases/llm-ab-case/*.svg

# ── Exceptions: ub22/palette — генератор и его источник публикуются ──
# Без них cases/**/*.py и cases/**/*.csv молча выбрасывают из коммита
# build_data.py и ub_final.csv, а сгенерированный data.js остаётся.
# Правило репо — генератор и вывод едут вместе, поэтому исключения явные.
!cases/ub22/palette/build_data.py
!cases/ub22/palette/ub_final.csv

# ── Exceptions: telenok — датасет кейса публикуется ──
# cases/**/*.csv выбросило бы raw-выгрузку из коммита, оставив xlsx рядом.
# Проверено git check-ignore: без этой строки csv молча не попадает.
!cases/telenok/assets/telenok_money_raw.csv

# ── Exceptions: explicit case-level publish files ──
!cases/**/index.html
!cases/**/charts.js
!cases/**/chart.js
!cases/**/summary.json
!cases/**/metrics_v2.json
!cases/**/README.md
!cases/**/.gitignore
.lycheecache

# library backups
workspace/library/*.bak

# secrets — never commit (security.md)
.env
